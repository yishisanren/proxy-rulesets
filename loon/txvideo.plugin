#!name = 腾讯视频净化
#!desc = 去除开屏广告、视频播放前广告、底部的多余 tap 栏、我的页面美化、我的界面顶部广告（由 Quantumult X 规则 TxvideoAD.snippet 自动转换，上游更新于 2026-11-03）
#!author = TG@ZenMoFiShi
#!homepage = https://github.com/ZenmoFeiShi/Qx

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
http-request ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/Txvideoad.js, requires-body=true, binary-body-mode=true, tag=txvideo-Txvideoad-1
http-response ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/Txvideoad.js, requires-body=true, binary-body-mode=true, tag=txvideo-Txvideoad-2
http-response ^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/Txvideoad.js, requires-body=true, binary-body-mode=true, tag=txvideo-Txvideoad-3
http-response ^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/Txvideoad.js, requires-body=true, binary-body-mode=true, tag=txvideo-Txvideoad-4
http-response ^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/Txvideoad.js, requires-body=true, binary-body-mode=true, tag=txvideo-Txvideoad-5

[MITM]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
