#!name = 腾讯体育净化
#!desc = 去除开屏广告、优化我的页面、去除底部会员tap、优化首页展示、去除搜索热词（由 Quantumult X 规则 txsports-ad-clean.snippet 自动转换，上游更新于 2026-11-1）
#!author = TG@ZenMoFiShi
#!homepage = https://github.com/ZenmoFeiShi/Qx

[Script]
http-response ^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/txsports-ad-clean.js, requires-body=true, binary-body-mode=true, tag=txsports-txsports-ad-clean-1
http-response ^https:\/\/k\.ssp\.qq\.com\/getsdkconfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/txsports-ad-clean.js, requires-body=true, binary-body-mode=true, tag=txsports-txsports-ad-clean-2
http-response ^https:\/\/app\.sports\.qq\.com\/init\/config(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/txsports-ad-clean.js, requires-body=true, binary-body-mode=true, tag=txsports-txsports-ad-clean-3
http-response ^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/txsports-ad-clean.js, requires-body=true, binary-body-mode=true, tag=txsports-txsports-ad-clean-4
http-response ^https:\/\/app\.sports\.qq\.com\/m\/match\/liveSum(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/txsports-ad-clean.js, requires-body=true, binary-body-mode=true, tag=txsports-txsports-ad-clean-5
http-response ^https:\/\/app\.sports\.qq\.com\/match\/multiUpdate(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/txsports-ad-clean.js, requires-body=true, binary-body-mode=true, tag=txsports-txsports-ad-clean-6
http-response ^https:\/\/app\.sports\.qq\.com\/feeds\/(?:home|list)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/txsports-ad-clean.js, requires-body=true, binary-body-mode=true, tag=txsports-txsports-ad-clean-7
http-response ^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$ script-path=https://raw.githubusercontent.com/yishisanren/proxy-rulesets/main/loon/scripts/txsports-ad-clean.js, requires-body=true, binary-body-mode=true, tag=txsports-txsports-ad-clean-8

[MITM]
hostname = config.ab.qq.com, k.ssp.qq.com, app.sports.qq.com, sports.ssp.qq.com
